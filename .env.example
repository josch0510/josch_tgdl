# Copy to .env and run: chmod 600 .env
# Get API_ID / API_HASH from https://my.telegram.org -> API development tools
API_ID=
API_HASH=

# Download directories must be under one of these roots (separated by ':').
# Only editable here, never from the web UI.
ALLOWED_BASE_DIRS=/home/youruser/tgdl-downloads

# Web UI bind address (keep 127.0.0.1 and use an SSH tunnel)
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Set to true only if you serve the UI over HTTPS
COOKIE_SECURE=false

# EXAMPLE ONLY - generate the real file for your installation with:
#   .venv/bin/tgdl systemd-unit --system | sudo tee /etc/systemd/system/tgdl.service
# Generated by `tgdl systemd-unit` --system
[Unit]
Description=tgdl - Telegram media downloader
Documentation=https://github.com/josch0510/josch_tgdl
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=YOURUSER
Group=YOURUSER
WorkingDirectory=/home/YOURUSER/tgdl
Environment=TGDL_HOME=/home/YOURUSER/tgdl
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOURUSER/tgdl/.venv/bin/tgdl --lang zh-TW serve
# Connecting to Telegram can take a while; graceful stop removes/keeps .part files.
TimeoutStartSec=180
TimeoutStopSec=60
WatchdogSec=120
Restart=on-failure
RestartSec=15
# 78 = configuration problem (not logged in, bad .env): do not restart-loop.
RestartPreventExitStatus=78

# Hardening
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
# tgdl may only write its own directory and the allowed download directories
ReadWritePaths=/home/YOURUSER/tgdl /home/YOURUSER/tgdl-downloads
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

# EXAMPLE ONLY - generate the real file for your installation with:
#   .venv/bin/tgdl --lang zh-TW systemd-unit > ~/.config/systemd/user/tgdl.service
# Generated by `tgdl systemd-unit`
[Unit]
Description=tgdl - Telegram media downloader
Documentation=https://github.com/josch0510/josch_tgdl
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/home/YOURUSER/tgdl
Environment=TGDL_HOME=/home/YOURUSER/tgdl
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/YOURUSER/tgdl/.venv/bin/tgdl --lang zh-TW serve
# Connecting to Telegram can take a while; graceful stop removes/keeps .part files.
TimeoutStartSec=180
TimeoutStopSec=60
WatchdogSec=120
Restart=on-failure
RestartSec=15
# 78 = configuration problem (not logged in, bad .env): do not restart-loop.
RestartPreventExitStatus=78

# Hardening
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
